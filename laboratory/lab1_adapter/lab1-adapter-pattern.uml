@startuml

' Target Interface
interface FileWriter {
    +write(string $filename, array $rows): bool
}

' Adaptees (Legacy Libraries - Cannot Change)
class CsvLibrary {
    +writeCsv(string $path, array $rows): bool
}

class JsonLibrary {
    +saveJson(string $path, mixed $payload): bool
}

class TextLibrary {
    +appendLine(string $path, string $line): bool
}

' Adapters
class CsvFileAdapter {
    -csv: CsvLibrary
    +__construct(CsvLibrary $csv)
    +write(string $filename, array $rows): bool
}

class JsonFileAdapter {
    -json: JsonLibrary
    +__construct(JsonLibrary $json)
    +write(string $filename, array $rows): bool
}

class TextFileAdapter {
    -text: TextLibrary
    +__construct(TextLibrary $text)
    +write(string $filename, array $rows): bool
}

' Client
class ReportExporter {
    -writer: FileWriter
    +__construct(FileWriter $writer)
    +export(string $filename, array $rows): void
}

' Relationships
FileWriter <|.. CsvFileAdapter
FileWriter <|.. JsonFileAdapter
FileWriter <|.. TextFileAdapter

CsvFileAdapter --> CsvLibrary
JsonFileAdapter --> JsonLibrary
TextFileAdapter --> TextLibrary

ReportExporter --> FileWriter

@enduml
