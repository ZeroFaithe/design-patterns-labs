@startuml

' Component Interface
interface HttpClient {
    +get(string $url): string
}

' Concrete Component
class BaseHttpClient {
    +get(string $url): string
}

' Base Decorator
class HttpDecorator {
    #wrapped: HttpClient
    +__construct(HttpClient $wrapped)
}

' Concrete Decorators
class LoggingDecorator {
    +get(string $url): string
}

class CachingDecorator {
    -cache: array
    +get(string $url): string
}

class RetryDecorator {
    +get(string $url): string
}

class TokenCounterDecorator {
    +get(string $url): string
}

' Relationships
HttpClient <|.. BaseHttpClient
HttpClient <|.. HttpDecorator

HttpDecorator <|-- LoggingDecorator
HttpDecorator <|-- CachingDecorator
HttpDecorator <|-- RetryDecorator
HttpDecorator <|-- TokenCounterDecorator

HttpDecorator o-- HttpClient : wrapped

@enduml
